{
  NAME "Get active Paperbell job progress"
  OPERATION Get-Jobs
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR keyword requested-attributes job-id,job-state,job-impressions-completed,job-media-sheets-completed
  STATUS successful-ok
  DISPLAY job-id
  DISPLAY job-state
  DISPLAY job-impressions-completed
  DISPLAY job-media-sheets-completed
}
