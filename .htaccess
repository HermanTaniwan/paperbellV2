Options -Indexes

# app.paperbell.id saat ini hanya tersedia lewat HTTP pada jaringan privat.
# Jangan redirect ke HTTPS sebelum Apache memiliki listener dan sertifikat 443.

AddType application/x-x509-ca-cert .crt

<FilesMatch "^(config\.php|setup\.php|package.*|README\.md|start-paperbell\.ps1)$">
    Require all denied
</FilesMatch>
