Options -Indexes

RewriteEngine On

# Paksa domain publik memakai HTTPS, tetapi biarkan akses langsung dari LAN
# tetap memakai HTTP. Server lokal belum memasang listener/certificate HTTPS.
RewriteCond %{HTTP_HOST} ^app\.paperbell\.id(?::[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteCond %{REMOTE_ADDR} !^127\. [NC]
RewriteCond %{REMOTE_ADDR} !^::1$ [NC]
RewriteCond %{REMOTE_ADDR} !^10\. [NC]
RewriteCond %{REMOTE_ADDR} !^192\.168\. [NC]
RewriteCond %{REMOTE_ADDR} !^172\.(1[6-9]|2[0-9]|3[01])\. [NC]
RewriteRule ^ https://app.paperbell.id%{REQUEST_URI} [R=301,L,NE]

AddType application/x-x509-ca-cert .crt

<FilesMatch "^(config\.php|setup\.php|package.*|README\.md|start-paperbell\.ps1)$">
    Require all denied
</FilesMatch>
